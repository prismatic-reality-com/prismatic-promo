{
  "name": "prismatic-platform-promo",
  "version": "1.0.0",
  "description": "Promotional site for Prismatic Platform",
  "main": "debug-generate.js",
  "scripts": {
    "test": "bash scripts/test-template-regression.sh --templates",
    "test:build": "bash scripts/test-template-regression.sh --build",
    "test:all": "bash scripts/test-template-regression.sh --all",
    "test:e2e": "npx playwright test",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e:firefox": "npx playwright test --project=firefox",
    "test:e2e:webkit": "npx playwright test --project=webkit",
    "test:e2e:mobile": "npx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:html": "npx playwright test html-structure",
    "test:e2e:content": "npx playwright test content-duplication",
    "test:e2e:alpine": "npx playwright test alpine-js",
    "test:e2e:visual": "npx playwright test visual-consistency",
    "test:e2e:responsive": "npx playwright test responsive",
    "test:e2e:navbar": "npx playwright test navbar",
    "test:e2e:perf": "npx playwright test performance",
    "test:e2e:report": "npx playwright show-report",
    "test:navigation:smoke": "npx playwright test tests/navigation/navigation-smoke.spec.ts --project=chromium",
    "test:navigation:comprehensive": "npx playwright test tests/navigation/navigation-comprehensive.spec.ts",
    "test:navigation:mobile": "npx playwright test tests/navigation/navigation-comprehensive.spec.ts --project=mobile-chrome",
    "test:navigation:performance": "npx playwright test tests/navigation/navigation-comprehensive.spec.ts --grep='Performance'",
    "test:navigation:accessibility": "npx playwright test tests/navigation/navigation-comprehensive.spec.ts --grep='Accessibility'",
    "test:navigation:visual": "npx playwright test tests/navigation/navigation-comprehensive.spec.ts --grep='Visual'",
    "test:navigation:all": "npm run test:navigation:smoke && npm run test:navigation:comprehensive",
    "test:full": "bash scripts/test-template-regression.sh --all && npx playwright test --project=chromium",
    "test:jest": "jest --config tests/jest.config.js",
    "test:jest:watch": "jest --config tests/jest.config.js --watch",
    "test:jest:coverage": "jest --config tests/jest.config.js --coverage",
    "test:chart": "jest --config tests/jest.config.js tests/unit/chart-integration.test.js",
    "test:chart:watch": "jest --config tests/jest.config.js tests/unit/chart-integration.test.js --watch",
    "test:performance": "jest --config tests/jest.config.js tests/performance/chart-performance.test.js",
    "test:security": "jest --config tests/jest.config.js tests/unit/chart-security.test.js",
    "build": "bash scripts/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/korczis/prismatic-platform.git",
    "directory": "sites/promo"
  },
  "keywords": [],
  "author": "Prismatic Platform Team",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/korczis/prismatic-platform/-/issues"
  },
  "homepage": "https://prismatic-reality.com",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "autoprefixer": "^10.4.24",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporters": "^3.1.0",
    "jest-junit": "^16.0.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "serve": "^14.2.5",
    "tailwindcss": "^3.4.19",
    "web-vitals": "^4.2.4"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "flowbite": "^2.3.0"
  }
}
