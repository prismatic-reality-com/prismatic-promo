digraph KellnerCluster {
    // === GLOBAL STYLE ===
    rankdir=TB;
    bgcolor="#0f172a";
    node [fontname="Inter", fontsize=10, style="rounded,filled", color="#475569"];
    edge [fontname="Inter", fontsize=8, color="#94a3b8", fontcolor="#cbd5e1"];

    // === SUBGRAPHS / CLUSTERS ===
    subgraph cluster_amalar {
        label="AMALAR Holding (CZ, 12.11.2023)";
        labeljust=l; fontcolor="#fbbf24"; color="#fbbf24"; style=dashed;
        AMALAR [label="AMALAR HOLDING\n12.11.2023 • CZ", fillcolor="#1f2937", fontcolor="#fbbf24", penwidth=3];
        BOD [label="Board of Directors\n(rodina)", fillcolor="#1e3a8a", fontcolor="#dbeafe"];
        FAB [label="Family Advisory Board", fillcolor="#1e3a8a", fontcolor="#dbeafe"];
        FIC [label="Family Investment Council", fillcolor="#1e3a8a", fontcolor="#dbeafe"];
    }

    subgraph cluster_subjects {
        label="DD Subjects";
        labeljust=l; fontcolor="#fca5a5"; color="#7f1d1d"; style=dashed;
        RENATA [label="Renáta Kellnerová\nDOB 4.7.1967\nprincipal", fillcolor="#7f1d1d", fontcolor="#ffffff", penwidth=2];
        ANNA [label="Anna Kellnerová\nDOB 26.11.1996\ndcera", fillcolor="#7f1d1d", fontcolor="#ffffff", penwidth=2];
        OTRUBA [label="Tomáš Otruba\nMgr. • DOB 19.9.1972\nlife partner", fillcolor="#7f1d1d", fontcolor="#ffffff", penwidth=2];
        SEVELA [label="Robert Ševela\nIng., Ph.D.\n~20 let PPF", fillcolor="#7f1d1d", fontcolor="#ffffff", penwidth=2];
    }

    subgraph cluster_family_out {
        label="Family (outside DD)";
        labeljust=l; fontcolor="#9ca3af"; color="#9ca3af"; style=dashed;
        LARA [label="Lara Kodl Kellnerová", fillcolor="#374151", fontcolor="#d1d5db", style="rounded,filled,dashed"];
        MARIE [label="Marie Isabella Kellnerová", fillcolor="#374151", fontcolor="#d1d5db", style="rounded,filled,dashed"];
        PETRJR [label="Petr Kellner Jr.\nexited 21.8.2025", fillcolor="#374151", fontcolor="#d1d5db", style="rounded,filled,dashed"];
    }

    subgraph cluster_ppf {
        label="PPF Group (NL→CZ H1 2026)";
        labeljust=l; fontcolor="#7dd3fc"; color="#0c4a6e"; style=dashed;
        PPF [label="PPF Group N.V.\nNL → CZ H1 2026", fillcolor="#0c4a6e", fontcolor="#e0f2fe", penwidth=2];
        O2 [label="O2 Czech Republic\n100% PPF", fillcolor="#0e7490", fontcolor="#cffafe"];
        CETIN [label="CETIN Czech", fillcolor="#0e7490", fontcolor="#cffafe"];
        EAND [label="e& PPF Telecom\nJV 10/2024\n(50% minus 1)", fillcolor="#0e7490", fontcolor="#cffafe"];
        CME [label="CME / Markíza", fillcolor="#0e7490", fontcolor="#cffafe"];
        HOMECREDIT [label="Home Credit residual\nexits 2024-2025", fillcolor="#0e7490", fontcolor="#cffafe"];
        SOTIO [label="Sotio Biotech", fillcolor="#0e7490", fontcolor="#cffafe"];
        SKODA [label="Škoda Group", fillcolor="#0e7490", fontcolor="#cffafe"];
        PPFRE [label="PPF Real Estate\nTampa FL ~1 mld Kč", fillcolor="#0e7490", fontcolor="#cffafe"];
        AIRBANK [label="Air Bank / Mobi Banka", fillcolor="#0e7490", fontcolor="#cffafe"];
    }

    subgraph cluster_otruba_par {
        label="Otruba parallel businesses";
        labeljust=l; fontcolor="#fde047"; color="#854d0e"; style=dashed;
        NIH [label="Nordic Investors\nHospitality\n(rebrand 6/2025)", fillcolor="#854d0e", fontcolor="#fef9c3"];
        NTR [label="Nordic Telecom Regional\nprodáno O2 6/2024", fillcolor="#854d0e", fontcolor="#fef9c3"];
        HOTEL_GHH [label="Grand Hotel Hradec", fillcolor="#854d0e", fontcolor="#fef9c3"];
        HOTEL_OMNIA [label="Omnia + Vyhlídka\nJanské Lázně", fillcolor="#854d0e", fontcolor="#fef9c3"];
        HOTEL_HARMONY [label="Harmony Špindl", fillcolor="#854d0e", fontcolor="#fef9c3"];
        HOTEL_MIN [label="Hilton + Four Seasons\nPraha (minoritní)", fillcolor="#854d0e", fontcolor="#fef9c3"];
        AK [label="Advokátní kancelář\nIČO 60178779", fillcolor="#854d0e", fontcolor="#fef9c3"];
        BBH [label="BBH 2004-2014\nIntl Managing Partner", fillcolor="#3f3f46", fontcolor="#e4e4e7", style="rounded,filled,dashed"];
    }

    subgraph cluster_sevela_par {
        label="Ševela parallel";
        labeljust=l; fontcolor="#fde047"; color="#854d0e"; style=dashed;
        CZECHTOLL [label="CzechToll\njednatel 2018\n(později Okáli)", fillcolor="#854d0e", fontcolor="#fef9c3"];
    }

    subgraph cluster_council {
        label="Other council members";
        labeljust=l; fontcolor="#cbd5e1"; color="#1e293b"; style=dashed;
        RUSNOK [label="Jiří Rusnok\nAdvisory", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        SOUCEK [label="Magdalena Souček\nAdvisory", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        SMEJC [label="Jiří Šmejc\nAdvisory", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        POMAHAC [label="Bohdan Pomahač\nAdvisory", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        VLCEK [label="Martin Vlček\nInvestment", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        TOMANIK [label="Jan Tomaník\nInvestment", fillcolor="#1e293b", fontcolor="#cbd5e1"];
        BRZOBOHATY [label="Tomáš Brzobohatý\nspecial advisor", fillcolor="#1e293b", fontcolor="#cbd5e1"];
    }

    FOUNDATION [label="The Kellner Family\nFoundation (CZ)", fillcolor="#581c87", fontcolor="#f3e8ff", penwidth=2];

    BARTONICEK [label="L. Bartoníček\nexited 31.8.2023", fillcolor="#450a0a", fontcolor="#fecaca", style="rounded,filled,dashed"];
    DUVIEUSART [label="J-P. Duvieusart\nexited 31.8.2023", fillcolor="#450a0a", fontcolor="#fecaca", style="rounded,filled,dashed"];

    // === EDGES: AMALAR ownership ===
    RENATA -> AMALAR [label="66.667%", color="#fbbf24", fontcolor="#fbbf24", penwidth=2];
    ANNA -> AMALAR [label="11.111%", color="#fbbf24", fontcolor="#fbbf24"];
    LARA -> AMALAR [label="11.111%", color="#94a3b8", fontcolor="#94a3b8", style=dashed];
    MARIE -> AMALAR [label="11.111%", color="#94a3b8", fontcolor="#94a3b8", style=dashed];

    // === Governance ===
    AMALAR -> BOD [label="governance"];
    AMALAR -> FAB [label="governance"];
    AMALAR -> FIC [label="governance"];
    OTRUBA -> FAB [label="member (12.11.2023)", color="#fbbf24"];
    SEVELA -> FIC [label="member (12.11.2023)", color="#fbbf24"];
    RUSNOK -> FAB; SOUCEK -> FAB; SMEJC -> FAB; POMAHAC -> FAB;
    VLCEK -> FIC; TOMANIK -> FIC;
    BRZOBOHATY -> AMALAR [label="special advisor", style=dotted];

    // === AMALAR → PPF ===
    AMALAR -> PPF [label="78.74%", color="#7dd3fc", fontcolor="#7dd3fc", penwidth=2];
    RENATA -> PPF [label="direct holdings", style=dashed, color="#94a3b8"];
    ANNA -> PPF [label="direct holdings", style=dashed, color="#94a3b8"];
    LARA -> PPF [label="direct holdings", style=dashed, color="#94a3b8"];
    MARIE -> PPF [label="direct holdings", style=dashed, color="#94a3b8"];
    PETRJR -> PPF [label="10% sold 21.8.2025", style=dashed, color="#dc2626", fontcolor="#dc2626"];
    BARTONICEK -> PPF [label="exited 31.8.2023", style=dashed, color="#dc2626", fontcolor="#dc2626"];
    DUVIEUSART -> PPF [label="exited 31.8.2023", style=dashed, color="#dc2626", fontcolor="#dc2626"];

    // === PPF holdings ===
    PPF -> O2; PPF -> CETIN; PPF -> EAND; PPF -> CME; PPF -> HOMECREDIT;
    PPF -> SOTIO; PPF -> SKODA; PPF -> PPFRE; PPF -> AIRBANK;

    // === Otruba PPF chair ===
    OTRUBA -> PPF [label="dozorčí rada chair (od 7/2025)", color="#fca5a5", fontcolor="#fca5a5", penwidth=2];

    // === Sevela operational ===
    SEVELA -> PPFRE [label="real-estate director", color="#fca5a5", fontcolor="#fca5a5"];
    SEVELA -> CZECHTOLL [label="historical jednatel 2018", style=dashed, color="#94a3b8"];

    // === Otruba parallel ===
    OTRUBA -> NIH [label="founder/owner", color="#fde047"];
    OTRUBA -> AK [label="advokát", color="#fde047"];
    OTRUBA -> BBH [label="2004-2014 (former)", style=dashed];
    NIH -> NTR [label="prodáno 6/2024", style=dashed];
    NIH -> HOTEL_GHH; NIH -> HOTEL_OMNIA; NIH -> HOTEL_HARMONY; NIH -> HOTEL_MIN;

    // === Foundation ===
    RENATA -> FOUNDATION [label="founder + chairwoman", color="#c084fc", fontcolor="#c084fc", penwidth=2];
    ANNA -> FOUNDATION [label="supervisory board (od 6/2021)", color="#c084fc", fontcolor="#c084fc"];

    // === Renáta ↔ Otruba personal ===
    RENATA -> OTRUBA [label="life partner od 4/2024\n(ÚOHS posuzuje JV)", style=dashed, color="#f472b6", fontcolor="#f472b6", penwidth=2];
}
